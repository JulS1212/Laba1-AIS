
<Window x:Class="ArtGallery.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Галерея искусств - MVVM" 
        Height="650" 
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Галерея искусств" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Основной контент: список и форма -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ЧАСТЬ: Список картин -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="Список картин:" 
                               FontWeight="Bold" Margin="5"/>

                    <ListView ItemsSource="{Binding Paintings}" 
                              SelectedItem="{Binding SelectedPainting}"
                              Height="300">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Название" 
                                                DisplayMemberBinding="{Binding Title}" 
                                                Width="150"/>
                                <GridViewColumn Header="Автор" 
                                                DisplayMemberBinding="{Binding Artist}" 
                                                Width="120"/>
                                <GridViewColumn Header="Год" 
                                                DisplayMemberBinding="{Binding Year}" 
                                                Width="80"/>
                                <GridViewColumn Header="Жанр" 
                                                DisplayMemberBinding="{Binding Genre}" 
                                                Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- ПРАВАЯ ЧАСТЬ: Форма редактирования -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="5,0,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Информация о картине:" 
                               FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Поля ввода -->
                    <StackPanel>
                        <TextBlock Text="Название картины:"/>
                        <TextBox Text="{Binding Title}" 
                                 Margin="0,2,0,5"/>

                        <TextBlock Text="Автор:"/>
                        <TextBox Text="{Binding Artist}" 
                                 Margin="0,2,0,5"/>

                        <TextBlock Text="Год создания:"/>
                        <TextBox Text="{Binding Year}" 
                                 Margin="0,2,0,5"/>

                        <TextBlock Text="Жанр:"/>
                        <TextBox Text="{Binding Genre}" 
                                 Margin="0,2,0,15"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- КНОПКИ УПРАВЛЕНИЯ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10">
            <!-- Основные действия -->
            <Button Content="Загрузить" 
                    Command="{Binding LoadCommand}" 
                    Width="100" Margin="5"/>
            <Button Content="Добавить" 
                    Command="{Binding AddCommand}" 
                    Width="100" Margin="5"/>
            <Button Content="Удалить" 
                    Command="{Binding DeleteCommand}" 
                    Width="100" Margin="5"/>
            <Button Content="Изменить" 
                    Command="{Binding UpdateCommand}" 
                    Width="100" Margin="5"/>
            <Button Content="Очистить" 
                    Command="{Binding ClearCommand}" 
                    Width="100" Margin="5"/>
        </StackPanel>

        <!-- ПОИСК И СОРТИРОВКА -->
        <Grid Grid.Row="3" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Поиск по годам -->
            <Border Grid.Column="0" BorderBrush="LightGray" 
                    BorderThickness="1" Padding="10" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="Поиск по годам:" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <TextBox Text="{Binding StartYear}" 
                                 Width="60" Margin="0,0,5,0"/>
                        <TextBlock Text=" - " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding EndYear}" 
                                 Width="60" Margin="5,0,5,0"/>
                        <Button Content="Найти" 
                                Command="{Binding SearchByYearCommand}" 
                                Width="60"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Сортировка и группировка -->
            <Border Grid.Column="1" BorderBrush="LightGray" 
                    BorderThickness="1" Padding="10" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="Сортировка и группировка:" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center">
                        <Button Content="А-Я" 
                                Command="{Binding SortAscendingCommand}" 
                                Width="80" Margin="0,0,5,0"/>
                        <Button Content="Я-А" 
                                Command="{Binding SortDescendingCommand}" 
                                Width="80" Margin="0,0,5,0"/>
                        <Button Content="По жанрам" 
                                Command="{Binding GroupByGenreCommand}" 
                                Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>